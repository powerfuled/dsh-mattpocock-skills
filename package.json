{
  "name": "@powefuled/dsh-matt-pocock-skills",
  "version": "0.1.0",
  "description": "DeepSeek Harness plugin that mirrors Matt Pocock's agent skills (github.com/mattpocock/skills) into DSH as mp-* skills, with background sync, per-skill toggles and manual sync/management tools.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/powerfuled/dsh-mattpocock-skills.git"
  },
  "homepage": "https://github.com/powerfuled/dsh-mattpocock-skills#readme",
  "bugs": {
    "url": "https://github.com/powerfuled/dsh-mattpocock-skills/issues"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4",
    "yaml": "^2.4.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5.0.0"
  },
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "scripts": {
    "test": "node --test",
    "smoke": "node scripts/smoke.mjs"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "skills",
    "agent-skills",
    "matt-pocock",
    "mattpocock"
